# Copia este archivo a .env y rellena los valores de tu proyecto Supabase.
# Project Settings → API. Usa SOLO la clave anon / publishable.
# NUNCA pongas aquí la service_role ni una clave secreta (sb_secret_...).
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=PEGA_AQUI_LA_CLAVE_ANON
